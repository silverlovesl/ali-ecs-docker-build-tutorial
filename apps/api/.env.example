# Application environment: development | staging | production
APP_ENV=development

# HTTP port the Gin server binds to
PORT=8080

# Comma separated list of browser origins allowed to call the API
ALLOW_ORIGINS=http://localhost:3000

# Directory with a built frontend to serve as a single-page app. Leave empty in
# development (Vite serves the frontend); the production image sets it to
# /app/public so one process serves both the SPA and the API.
WEB_DIR=
