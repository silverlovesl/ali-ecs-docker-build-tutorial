{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "Go + Gin API with hot reload via air",
  "scripts": {
    "dev": "air",
    "build": "go build -trimpath -o bin/api .",
    "start": "./bin/api",
    "lint": "go vet ./...",
    "lint:fix": "go vet ./...",
    "format": "gofmt -w .",
    "format:check": "test -z \"$(gofmt -l .)\"",
    "typecheck": "go build ./...",
    "test": "go test ./...",
    "clean": "rm -rf bin tmp"
  }
}
